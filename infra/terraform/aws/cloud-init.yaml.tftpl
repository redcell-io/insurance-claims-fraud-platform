#cloud-config
# Rendered by compute.tf's templatefile() call — see that file's
# `local.deploy_files`/`local.cloud_init` for what's injected here.
#
# Copied byte-for-byte from infra/terraform/oci/cloud-init.yaml.tftpl —
# nothing here is OCI-specific, it only references deploy_files/ocir_*
# template variables, both equally applicable to any cloud's VM. See
# infra/terraform/oci/README.md "Porting to another cloud". AWS's
# official Ubuntu AMIs also default to the "ubuntu" user, same as OCI's
# Canonical image and Azure's deliberately-matched admin_username — so
# this needed zero changes, not even a username swap.
#
# Ships the deploy-stack's compose files + config/ straight from this
# Terraform apply, base64-encoded to survive arbitrary YAML/compose
# content untouched, rather than `git clone`-ing the repo onto the
# instance — no repo credentials (public or private) ever need to exist
# on the VM. See DECISIONS.md #21.
write_files:
%{ for path, content in deploy_files ~}
  - path: /opt/claimfraud/${path}
    # gz+b64, not plain b64 — found on a real AWS apply: the 5 shipped
    # files total ~11KB raw, which after base64 inflation (+33%) plus
    # YAML structural overhead exceeded EC2's hard 16384-byte user_data
    # limit ("expected length of user_data to be in the range (0 -
    # 16384)"). Gzip-compressing first (base64gzip(), cloud-init's
    # native gz+b64 write_files encoding) comfortably clears it for
    # text/YAML content like this, and is a strict improvement for
    # OCI/Azure too (smaller payload), so it's applied here rather than
    # only in a divergent AWS-specific copy.
    encoding: gz+b64
    content: ${base64gzip(content)}
    owner: root:root
    permissions: '0644'
%{ endfor ~}

runcmd:
  # get.docker.com's convenience script installs both the Docker Engine
  # and the compose plugin in one step — fine for a demo-grade single
  # VM; a hardened setup would pin versions via the distro's own repo.
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker ubuntu
  # --password-stdin keeps the token out of the process list, though it
  # still sits in plaintext in this rendered cloud-init file itself
  # (readable via the instance's own metadata service) — the accepted
  # demo-grade tradeoff documented in variables.tf's ocir_auth_token and
  # DECISIONS.md #21.
  - echo '${ocir_auth_token}' | docker login ${ocir_host} -u '${ocir_username}' --password-stdin
  # OCIR_REGION is the bare region key (e.g. "iad") — docker-compose.deploy.images.yml
  # appends ".ocir.io" itself; passing ocir_host here would double it up.
  # IMAGE_TAG picks which architecture's pre-built images to pull — see
  # compute.tf's templatefile() call; this VM is x86_64, so it's
  # "latest-amd64" here, not the "latest" (arm64) the other two clouds use.
  - cd /opt/claimfraud && OCIR_REGION=${ocir_region_key} OCIR_NAMESPACE=${ocir_namespace} IMAGE_TAG=${image_tag} docker compose -f docker-compose.deploy.yml -f docker-compose.deploy.images.yml pull
  - cd /opt/claimfraud && OCIR_REGION=${ocir_region_key} OCIR_NAMESPACE=${ocir_namespace} IMAGE_TAG=${image_tag} docker compose -f docker-compose.deploy.yml -f docker-compose.deploy.images.yml up -d

# Debugging a failed boot: `ssh ubuntu@<ip>` then
# `sudo cat /var/log/cloud-init-output.log` shows every command above
# plus its output, in order.
