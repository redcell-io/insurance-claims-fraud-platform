# Copy to terraform.tfvars (gitignored) and fill in. See README.md
# "Prerequisites" for where each value comes from.

tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "xx:xx:xx:...:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..xxxxx" # or the tenancy_ocid itself, for the root compartment

ssh_public_key          = "ssh-ed25519 AAAA... you@yourmachine"
ssh_allowed_cidr        = "203.0.113.5/32" # YOUR IP, not 0.0.0.0/0
rest_allowed_cidr       = "0.0.0.0/0"      # fine public — that's the point of the demo
prometheus_allowed_cidr = "203.0.113.5/32" # no auth on that UI — keep this one narrow

ocir_region_key  = "iad" # us-ashburn-1 -> iad; see provider docs for your region's key
ocir_namespace   = "yourtenancynamespace"
ocir_username    = "yourtenancynamespace/your.email@example.com"
ocir_auth_token  = "generate-via-oci-console-my-profile-auth-tokens"
