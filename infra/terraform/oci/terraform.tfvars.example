# Copy to terraform.tfvars (gitignored) and fill in. See README.md
# "Prerequisites" for where each value comes from. Values shared across
# every cloud this repo deploys to (ssh key, CIDRs, OCIR creds) live in
# ../shared.tfvars.example instead — apply with both -var-file flags.

tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "xx:xx:xx:...:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..xxxxx" # or the tenancy_ocid itself, for the root compartment
